# Zkopírujte do .env.local pro lokální vývoj. Na produkci nastavte stejné proměnné
# ve Vercelu (Project → Settings → Environment Variables). Skutečné hodnoty
# nikdy necommitujte – .env.local je v .gitignore.

# --- Resend (e-maily) ---
# API klíč s oprávněním „Sending access“, ideálně omezený na doménu asterionsoft.cz.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Odesílatel; doména musí být v Resendu ověřená.
INQUIRY_FROM_EMAIL="Asterion Software <poptavky@asterionsoft.cz>"
# Kam chodí upozornění na novou poptávku.
INQUIRY_NOTIFY_EMAIL=jan@asterionsoft.cz

# --- Supabase (ukládání poptávek) ---
# Project URL z Project Settings → API (nebo Data API).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Secret klíč (sb_secret_…) nebo starší service_role klíč. Jen na serveru, nikdy s prefixem NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Volitelné ---
# AI klasifikace poptávky (služba, naléhavost, shrnutí). Bez klíče se třídí podle pravidel.
ANTHROPIC_API_KEY=
# Cloudflare Turnstile proti spamu. Bez obou klíčů se widget nezobrazí a ověření se přeskočí.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Sůl pro hash IP adresy (omezení počtu odeslání). Libovolný náhodný řetězec.
INQUIRY_IP_SALT=
